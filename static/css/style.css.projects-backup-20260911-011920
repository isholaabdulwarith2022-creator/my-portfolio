/* ==================== PREMIUM BACKGROUND PATTERN ==================== */
html {
    background: #07070a;
}
body {
    background:
        radial-gradient(circle at 15% 10%, rgba(88, 28, 135, 0.18), transparent 30%),
        radial-gradient(circle at 85% 18%, rgba(37, 99, 235, 0.15), transparent 28%),
        radial-gradient(circle at 50% 55%, rgba(6, 182, 212, 0.08), transparent 32%),
        #07070a;
    background-attachment: fixed;
}
body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.34;
    background-image:
        linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: linear-gradient(
        to bottom,
        rgba(0,0,0,0.9),
        rgba(0,0,0,0.45) 45%,
        transparent 100%
    );
}
.hero,
.section,
footer {
    position: relative;
}
.hero::before,
.section::before {
    content: "";
    position: absolute;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(80px);
    opacity: 0.12;
}
.hero::before {
    top: 12%;
    right: 5%;
    background: #7c3aed;
}
.section:nth-of-type(2)::before {
    bottom: 10%;
    left: 3%;
    background: #06b6d4;
}
.section:nth-of-type(3)::before {
    top: 15%;
    right: 8%;
    background: #2563eb;
}
.section:nth-of-type(4)::before {
    bottom: 5%;
    left: 10%;
    background: #a855f7;
}
