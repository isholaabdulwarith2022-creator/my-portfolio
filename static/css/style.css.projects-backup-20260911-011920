    color: transparent;
}
.hero h1 span {
    background: linear-gradient(100deg, #ffffff, #9c82ff 42%, #00d9ff 75%, #ff4ecd);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}
.btn {
    border-radius: 12px;
    box-shadow: 0 10px 28px rgba(0,0,0,0.22);
}
.btn-primary {
    box-shadow: 0 12px 32px rgba(124,92,255,0.25);
}
.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 42px rgba(255,78,205,0.22);
}
.btn-secondary:hover {
    background: rgba(0,217,255,0.07);
