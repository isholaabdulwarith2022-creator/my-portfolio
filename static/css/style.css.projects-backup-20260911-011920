* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: radial-gradient(circle at 10% 10%, rgba(124, 92, 255, 0.10), transparent 28%), radial-gradient(circle at 90% 20%, rgba(0, 210, 255, 0.08), transparent 25%), radial-gradient(circle at 70% 85%, rgba(255, 60, 190, 0.07), transparent 28%), #050608;
    color: #f7f8fc;
    line-height: 1.6;
}

body.modal-open {
    overflow: hidden;
}

a {
    color: inherit;
    text-decoration: none;
}

button {
    font: inherit;
}

.container {
    width: min(1120px, 92%);
    margin: 0 auto;
}


/* ==================== NAVIGATION ==================== */

.navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(5, 6, 8, 0.88);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(18px);
}

.nav-container {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 1px;
}

.logo span,
footer strong span {
    color: #aeb5c3;
}

nav {
    display: flex;
    align-items: center;
    gap: 28px;
}

nav a {
    color: #aeb5c3;
    font-size: 0.9rem;
    transition: 0.3s ease;
}

nav a:hover {
    color: #ffffff;
}

.nav-contact {
    padding: 10px 18px;
    border: 1px solid rgba(124, 92, 255, 0.65);
    border-radius: 10px;
    color: #ffffff;
}

.menu-toggle {
    display: none;
    border: none;
    background: transparent;
    color: white;
    font-size: 1.7rem;
    cursor: pointer;
}


/* ==================== HERO ==================== */

.hero {
    min-height: 88vh;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.hero-content {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 80px;
    align-items: center;
    padding: 100px 0;
}

.hero-text {
    min-width: 0;
}

.eyebrow,
.section-label {
    color: #00d9ff;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 3px;
    margin-bottom: 20px;
}

.hero h1 {
    max-width: 750px;
    font-size: clamp(3rem, 6vw, 5.6rem);
    line-height: 1.02;
    letter-spacing: -4px;
}

.hero h1 span {
    display: block;
    color: #929aaa;
}

.hero-description {
    max-width: 620px;
    color: #aeb5c3;
    font-size: 1.1rem;
    margin: 30px 0;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 24px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.9rem;
    transition: 0.3s ease;
}

.btn-primary {
    background: linear-gradient(135deg, #7c5cff, #b44dff 52%, #ff4ecd);
    color: #ffffff;
}

.btn-primary:hover {
    transform: translateY(-3px);
}

.btn-secondary {
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #ffffff;
}

.btn-secondary:hover {
    border-color: #00d9ff;
}

.hero-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 38px;
}

.hero-tech span,
.project-tech span,
.skills-list span {
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 5px;
    padding: 7px 11px;
    color: #a9a9a9;
    font-size: 0.78rem;
}


/* ==================== PROFILE ==================== */

.hero-visual {
    display: flex;
    justify-content: center;
}

.profile-card {
    width: 330px;
    padding: 20px;
    border: 1px solid #2c2c2c;
    background: linear-gradient(145deg, rgba(20, 23, 31, 0.92), rgba(10, 12, 17, 0.92));
    border-radius: 14px;
}

.profile-image {
    width: 100%;
    height: 360px;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(124,92,255,0.14), rgba(0,217,255,0.08), rgba(255,78,205,0.10));
    border-radius: 10px;
    margin-bottom: 22px;
}

.profile-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.profile-info h3 {
    font-size: 1.25rem;
}

.profile-info p {
    color: #929aaa;
}

.status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    color: #8e8e8e;
    font-size: 0.8rem;
}

.status span {
    width: 8px;
    height: 8px;
    background: linear-gradient(135deg, #7c5cff, #b44dff 52%, #ff4ecd);
    border-radius: 50%;
}


/* ==================== SECTIONS ==================== */

.section {
    padding: 110px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.section-dark {
    background: rgba(13, 16, 22, 0.82);
}

.section-heading {
    max-width: 760px;
    margin-bottom: 55px;
}

.section-heading h2 {
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1.1;
    letter-spacing: -2px;
}

.section-heading > p:last-child {
    color: #a6adba;
    margin-top: 18px;
}


/* ==================== ABOUT ==================== */

.about-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 70px;
}

.about-text p {
    color: #aeb5c3;
    font-size: 1.05rem;
    margin-bottom: 22px;
}

.about-highlight {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: #333333;
    border: 1px solid rgba(255, 255, 255, 0.09);
}

.highlight {
    background: linear-gradient(145deg, rgba(20, 23, 31, 0.92), rgba(10, 12, 17, 0.92));
    min-height: 150px;
    padding: 25px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.highlight strong {
    font-size: 1.4rem;
}

.highlight span {
    color: #929aaa;
}


/* ==================== SERVICES ==================== */

.services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.service-card {
    border: 1px solid #2c2c2c;
    padding: 35px;
    transition: 0.3s ease;
}

.service-card:hover {
    transform: translateY(-5px);
    border-color: rgba(124, 92, 255, 0.48);
}

.service-number {
    color: #7c5cff;
    font-size: 0.8rem;
    margin-bottom: 30px;
}

.service-card h3 {
    font-size: 1.4rem;
    margin-bottom: 15px;
}

.service-card p {
    color: #a3aab7;
}


/* ==================== PROJECTS ==================== */

.projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
}

.project-card {
    overflow: hidden;
    border: 1px solid #2c2c2c;
    background: rgba(13, 16, 22, 0.82);
    transition: 0.3s ease;
}

.project-card:hover {
    transform: translateY(-5px);
    border-color: rgba(124, 92, 255, 0.48);
}

.project-featured {
    grid-column: 1 / -1;
}

.project-gallery {
    display: grid;
    gap: 5px;
    background: rgba(3, 5, 8, 0.72);
    border-bottom: 1px solid #2c2c2c;
}

.project-gallery.four-images {
    grid-template-columns: repeat(4, 1fr);
}

.project-gallery.two-images {
    grid-template-columns: repeat(2, 1fr);
}

.project-gallery.single-image {
    grid-template-columns: 1fr;
}

.gallery-image {
    position: relative;
    display: block;
    width: 100%;
    height: 230px;
    padding: 0;
    border: none;
    overflow: hidden;
    background: #0d1015;
    cursor: pointer;
}

.four-images .gallery-image {
    height: 230px;
}

.two-images .gallery-image {
    height: 260px;
}

.single-image .gallery-image {
    height: 300px;
}

.gallery-image::after {
    content: "VIEW";
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(124,92,255,0.30), rgba(0,0,0,0.68));
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 2px;
    opacity: 0;
    transition: 0.3s ease;
}

.gallery-image:hover::after {
    opacity: 1;
}

.gallery-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.gallery-image:hover img {
    transform: scale(1.04);
}

.project-content {
    padding: 28px;
}

.project-category {
    color: #00d9ff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 12px;
}

.project-content h3 {
    font-size: 1.35rem;
    line-height: 1.3;
    margin-bottom: 13px;
}

.project-content p {
    color: #a3aab7;
    margin-bottom: 20px;
}

.project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
}


/* ==================== IMAGE MODAL ==================== */

.image-modal {
    position: fixed;
    inset: 0;
    z-index: 3000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 30px;
    background: rgba(2, 3, 5, 0.96);
}

.image-modal.active {
    display: flex;
}

.modal-content {
    width: min(1200px, 95vw);
    max-height: 92vh;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.modal-content img {
    max-width: 100%;
    max-height: 82vh;
    object-fit: contain;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: linear-gradient(145deg, rgba(20, 23, 31, 0.92), rgba(10, 12, 17, 0.92));
}

.modal-content p {
    color: #cccccc;
    margin-top: 14px;
    text-align: center;
    font-size: 0.9rem;
}

.modal-close {
    position: absolute;
    top: 20px;
    right: 28px;
    width: 45px;
    height: 45px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 50%;
    background: linear-gradient(145deg, rgba(20, 23, 31, 0.92), rgba(10, 12, 17, 0.92));
    color: #ffffff;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    transition: 0.3s ease;
}

.modal-close:hover {
    background: linear-gradient(135deg, #7c5cff, #b44dff 52%, #ff4ecd);
    color: #ffffff;
}


/* ==================== SKILLS ==================== */

.skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.skills-list span {
    padding: 12px 18px;
    font-size: 0.9rem;
}


/* ==================== CONTACT ==================== */

.contact-section {
    text-align: center;
}

.contact-container {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.contact-section .section-heading {
    margin-bottom: 35px;
}

.contact-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
}


/* ==================== FOOTER ==================== */

footer {
    padding: 35px 0;
    background: rgba(3, 5, 8, 0.72);
}

.footer-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
}

footer strong {
    font-size: 1rem;
}

footer p {
    color: #737b8b;
    font-size: 0.8rem;
}

.footer-links {
    display: flex;
    gap: 20px;
}

.footer-links a {
    color: #929aaa;
    font-size: 0.85rem;
}

.footer-links a:hover {
    color: white;
}

.copyright {
    text-align: right;
}


/* ==================== MOBILE ==================== */

@media (max-width: 900px) {

    .hero-content,
    .about-grid {
        grid-template-columns: 1fr;
    }

    .hero-content {
        gap: 60px;
    }

    .hero {
        min-height: auto;
    }

    .hero-visual {
        justify-content: flex-start;
    }

    .profile-card {
        width: 100%;
        max-width: 380px;
    }
}


@media (max-width: 800px) {

    .menu-toggle {
        display: block;
    }

    nav {
        display: none;
        position: absolute;
        top: 76px;
        left: 0;
        width: 100%;
        padding: 25px 5%;
        flex-direction: column;
        align-items: flex-start;
        background: radial-gradient(circle at 10% 10%, rgba(124, 92, 255, 0.10), transparent 28%), radial-gradient(circle at 90% 20%, rgba(0, 210, 255, 0.08), transparent 25%), radial-gradient(circle at 70% 85%, rgba(255, 60, 190, 0.07), transparent 28%), #050608;
        border-bottom: 1px solid #292929;
    }

    nav.active {
        display: flex;
    }

    .services-grid,
    .projects-grid {
        grid-template-columns: 1fr;
    }

    .project-featured {
        grid-column: auto;
    }

    .project-gallery.four-images {
        grid-template-columns: repeat(2, 1fr);
    }

    .four-images .gallery-image {
        height: 220px;
    }

    .footer-container {
        flex-direction: column;
        align-items: flex-start;
    }

    .copyright {
        text-align: left;
    }
}


@media (max-width: 560px) {

    .section {
        padding: 80px 0;
    }

    .hero-content {
        padding: 80px 0;
    }

    .hero h1 {
        font-size: 2.8rem;
    }

    .hero-buttons .btn {
        width: 100%;
    }

    .about-highlight {
        grid-template-columns: 1fr;
    }

    .project-gallery.four-images,
    .project-gallery.two-images {
        grid-template-columns: 1fr;
    }

    .four-images .gallery-image,
    .two-images .gallery-image,
    .single-image .gallery-image {
        height: 260px;
    }

    .contact-buttons .btn {
        width: 100%;
    }

    .profile-image {
        height: 330px;
    }

    .image-modal {
        padding: 15px;
    }

    .modal-close {
        top: 10px;
        right: 12px;
    }
}/* ==================== PREMIUM UI LAYER ==================== */
body {
    position: relative;
    overflow-x: hidden;
}
body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    opacity: 0.24;
    background-image:
        linear-gradient(rgba(255,255,255,0.018) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.018) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: linear-gradient(to bottom, black, transparent 88%);
}
.navbar {
    box-shadow: 0 10px 35px rgba(0,0,0,0.18);
}
.logo {
    background: linear-gradient(90deg, #ffffff, #9c82ff, #00d9ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}
nav a {
    position: relative;
}
nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -8px;
    height: 2px;
    border-radius: 20px;
    background: linear-gradient(90deg, #7c5cff, #00d9ff);
    transition: right 0.25s ease;
}
nav a:hover::after {
    right: 0;
}
.nav-contact {
    background: rgba(124, 92, 255, 0.10);
    box-shadow: 0 8px 25px rgba(124,92,255,0.12);
}
.hero {
    position: relative;
    overflow: hidden;
}
