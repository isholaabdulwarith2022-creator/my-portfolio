    position: relative;
    overflow: hidden;
}
.contact-section::before {
    content: "";
    position: absolute;
    width: 520px;
    height: 520px;
    right: -230px;
    top: -240px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(124,92,255,0.15), rgba(255,78,205,0.05) 45%, transparent 70%);
    pointer-events: none;
}
.contact-container {
    position: relative;
    z-index: 1;
}
.contact-section .section-heading h2 {
    background: linear-gradient(100deg, #ffffff, #9c82ff, #00d9ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}
.modal-close {
    border-radius: 50%;
    background: rgba(18,21,28,0.90);
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
}
.modal-close:hover {
    background: linear-gradient(135deg, #7c5cff, #ff4ecd);
    color: #ffffff;
    border-color: transparent;
}
footer {
    border-top: 1px solid rgba(255,255,255,0.06);
}
::-webkit-scrollbar {
    width: 9px;
}
::-webkit-scrollbar-track {
    background: #050608;
}
::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, #7c5cff, #00d9ff);
    border-radius: 20px;
}
::selection {
    background: rgba(124,92,255,0.55);
    color: #ffffff;
}
@media (max-width: 800px) {
